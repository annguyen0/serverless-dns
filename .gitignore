# Ignoring directories
dist/
node_modules/
worker/
test/data/cache/
blocklists__/
dbip__/
src/basicconfig.json

# lock files
/package-lock.json
/deno.lock

.clinic/
**basicconfig.json
**filetag.json
# Committed blocklist config snapshots (src/u6-basicconfig.json,
# src/u6-filetag.json) are required by src/core/cfg.js at module-load on every
# runtime (Node, Deno, Deno Deploy, Workers, Fastly), so they must be tracked.
!src/u6-basicconfig.json
!src/u6-filetag.json
*.log
*.swp
*.bak

# Local enviroment variables
.env

# Cache
.eslintcache
bin/main.wasm
pkg/serverless-dns.tar.gz
